<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mehs - coding shortcuts for the MEHS layer of rafaelromao/keyboards.

  Meh   = Ctrl+Alt+Shift        (control alt shift)
  Hyper = Meh + Gui             (control alt shift meta)

  Generated for linux; parent keymap "$default".
  Every action id below was verified against the installed IDE.
  Inherited shortcuts are repeated verbatim because a child keymap
  REPLACES the parent's shortcut list for any action it names.
-->
<keymap version="1" name="Mehs" parent="$default" disable-mnemonics="true">
  <action id="ActivateAIAssistantToolWindow">
    <keyboard-shortcut first-keystroke="control alt shift SPACE"/>
  </action>
  <action id="ActivateProjectToolWindow">
    <keyboard-shortcut first-keystroke="alt 1"/>
    <keyboard-shortcut first-keystroke="control alt shift B"/>
  </action>
  <action id="CodeCompletion">
    <keyboard-shortcut first-keystroke="control SPACE"/>
    <keyboard-shortcut first-keystroke="control alt shift meta N"/>
  </action>
  <action id="CommentByBlockComment">
    <keyboard-shortcut first-keystroke="control shift SLASH"/>
    <keyboard-shortcut first-keystroke="control shift DIVIDE"/>
    <keyboard-shortcut first-keystroke="control alt shift meta C"/>
  </action>
  <action id="CommentByLineComment">
    <keyboard-shortcut first-keystroke="control SLASH"/>
    <keyboard-shortcut first-keystroke="control DIVIDE"/>
    <keyboard-shortcut first-keystroke="control alt shift C"/>
  </action>
  <action id="CompileDirty">
    <keyboard-shortcut first-keystroke="control F9"/>
    <keyboard-shortcut first-keystroke="control alt shift M"/>
  </action>
  <action id="CompileProject">
    <keyboard-shortcut first-keystroke="control alt shift meta M"/>
  </action>
  <action id="Debug">
    <keyboard-shortcut first-keystroke="shift F9"/>
    <keyboard-shortcut first-keystroke="control alt shift A"/>
  </action>
  <action id="EditorCompleteStatement">
    <keyboard-shortcut first-keystroke="control shift ENTER"/>
    <keyboard-shortcut first-keystroke="control alt shift S"/>
  </action>
  <action id="EvaluateExpression">
    <keyboard-shortcut first-keystroke="alt F8"/>
    <keyboard-shortcut first-keystroke="control alt shift F"/>
  </action>
  <action id="FindUsages">
    <keyboard-shortcut first-keystroke="alt F7"/>
    <keyboard-shortcut first-keystroke="control alt shift meta P"/>
  </action>
  <action id="Generate">
    <keyboard-shortcut first-keystroke="alt INSERT"/>
    <keyboard-shortcut first-keystroke="control alt shift meta F"/>
  </action>
  <action id="GotoAction">
    <keyboard-shortcut first-keystroke="control shift A"/>
    <keyboard-shortcut first-keystroke="control alt shift meta U"/>
  </action>
  <action id="GotoDeclaration">
    <keyboard-shortcut first-keystroke="control B"/>
    <mouse-shortcut keystroke="ctrl button1"/>
    <keyboard-shortcut first-keystroke="control alt shift meta Y"/>
  </action>
  <action id="GotoImplementation">
    <keyboard-shortcut first-keystroke="control alt B"/>
    <mouse-shortcut keystroke="ctrl alt button1"/>
    <keyboard-shortcut first-keystroke="control alt shift Y"/>
  </action>
  <action id="GotoNextBookmark">
    <keyboard-shortcut first-keystroke="control alt shift meta PERIOD"/>
  </action>
  <action id="GotoNextError">
    <keyboard-shortcut first-keystroke="F2"/>
    <keyboard-shortcut first-keystroke="control alt shift PERIOD"/>
  </action>
  <action id="GotoPreviousBookmark">
    <keyboard-shortcut first-keystroke="control alt shift meta COMMA"/>
  </action>
  <action id="GotoPreviousError">
    <keyboard-shortcut first-keystroke="shift F2"/>
    <keyboard-shortcut first-keystroke="control alt shift COMMA"/>
  </action>
  <action id="GotoSymbol">
    <keyboard-shortcut first-keystroke="control alt shift meta O"/>
  </action>
  <action id="InspectCode">
    <keyboard-shortcut first-keystroke="control alt shift meta G"/>
  </action>
  <action id="QuickChangeScheme">
    <keyboard-shortcut first-keystroke="control BACK_QUOTE"/>
    <keyboard-shortcut first-keystroke="control alt shift meta T"/>
  </action>
  <action id="QuickImplementations">
    <keyboard-shortcut first-keystroke="control shift I"/>
    <keyboard-shortcut first-keystroke="control alt shift P"/>
  </action>
  <action id="QuickJavaDoc">
    <keyboard-shortcut first-keystroke="control Q"/>
    <mouse-shortcut keystroke="alt button2"/>
    <keyboard-shortcut first-keystroke="control alt shift H"/>
  </action>
  <action id="RecentFiles">
    <keyboard-shortcut first-keystroke="control E"/>
    <keyboard-shortcut first-keystroke="control alt shift T"/>
  </action>
  <action id="Refactorings.QuickListPopupAction">
    <keyboard-shortcut first-keystroke="control alt shift meta S"/>
  </action>
  <action id="ReformatCode">
    <keyboard-shortcut first-keystroke="control alt L"/>
    <keyboard-shortcut first-keystroke="control alt shift G"/>
  </action>
  <action id="Resume">
    <keyboard-shortcut first-keystroke="F9"/>
    <keyboard-shortcut first-keystroke="control alt shift meta A"/>
  </action>
  <action id="Run">
    <keyboard-shortcut first-keystroke="shift F10"/>
    <keyboard-shortcut first-keystroke="control alt shift R"/>
  </action>
  <action id="SearchEverywhere">
    <keyboard-gesture-shortcut keystroke="shift SHIFT" modifier="dblClick"/>
    <keyboard-shortcut first-keystroke="control alt shift meta L"/>
  </action>
  <action id="SelectIn">
    <keyboard-shortcut first-keystroke="alt F1"/>
    <keyboard-shortcut first-keystroke="control alt shift meta B"/>
  </action>
  <action id="ShowIntentionActions">
    <keyboard-shortcut first-keystroke="alt ENTER"/>
    <keyboard-shortcut first-keystroke="control alt shift ENTER"/>
  </action>
  <action id="SmartTypeCompletion">
    <keyboard-shortcut first-keystroke="control shift SPACE"/>
    <keyboard-shortcut first-keystroke="control alt shift N"/>
  </action>
  <action id="StepInto">
    <keyboard-shortcut first-keystroke="F7"/>
    <keyboard-shortcut first-keystroke="control alt shift U"/>
  </action>
  <action id="StepOut">
    <keyboard-shortcut first-keystroke="shift F8"/>
    <keyboard-shortcut first-keystroke="control alt shift L"/>
  </action>
  <action id="StepOver">
    <keyboard-shortcut first-keystroke="F8"/>
    <keyboard-shortcut first-keystroke="control alt shift O"/>
  </action>
  <action id="Stop">
    <keyboard-shortcut first-keystroke="control F2"/>
    <keyboard-shortcut first-keystroke="control alt shift meta R"/>
  </action>
  <action id="ToggleBookmark">
    <keyboard-shortcut first-keystroke="F11"/>
    <keyboard-shortcut first-keystroke="control alt shift meta H"/>
  </action>
  <action id="ToggleLineBreakpoint">
    <keyboard-shortcut first-keystroke="control F8"/>
    <keyboard-shortcut first-keystroke="control alt shift E"/>
  </action>
  <action id="ViewBreakpoints">
    <keyboard-shortcut first-keystroke="control shift F8"/>
    <keyboard-shortcut first-keystroke="control alt shift meta E"/>
  </action>
  <action id="CopyReference"/>
  <action id="ShowProjectStructureSettings"/>
  <action id="ShowReformatFileDialog"/>
  <action id="TextSearchAction"/>
  <!-- plugin defaults cleared because they collide with a Meh chord -->
  <action id="Console.TableResult.EditFilterCriteria"/>  <!-- was control alt shift F : database console -->
  <action id="DatabaseView.FullTextSearch"/>  <!-- was control alt shift F : database view -->
  <action id="DatabaseView.OpenDdlInConsole"/>  <!-- was control alt shift B : database view -->
  <action id="DatabaseView.CopyDdlAction"/>  <!-- was control alt shift G : database view -->
  <action id="Console.TableResult.SubmitAndCommit"/>  <!-- was control alt shift ENTER : database console -->
  <action id="Console.Transaction.Commit"/>  <!-- was control alt shift ENTER : database console -->
  <action id="IntroduceTypeAlias"/>  <!-- was control alt shift A : Kotlin refactoring -->
  <action id="ExtractFunctionToScope"/>  <!-- was control alt shift M : Kotlin refactoring -->
</keymap>

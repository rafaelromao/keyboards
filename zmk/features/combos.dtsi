/*                KEY POSITIONS

  ╭─────────────────────╮ ╭─────────────────────╮
  │ LTP LTR LTM LTI LTC │ │ RTC RTI RTM RTR RTP │
  │ LHP LHR LHM LHI LHC │ │ RHC RHI RHM RHR RHP │
  │ LBP LBR LBM LBI LBC │ │ RBC RBI RBM RBR RBP │
  ╰───────╮ L2  L1  L0  │ │ R0  R1  R2  ╭───────╯
          ╰─────────────╯ ╰─────────────╯

  The 36 positions of definitions/config.dtsi; smaller boards park the ones
  they lack on unreachable matrix slots, which is why some letters exist only
  as chords. */

/ {
    /*
     * ALT_OS is the base layer wearing the Mac's modifiers, so it belongs to
     * every base-layer set. Spelling it out matters more than it looks: ALT_OS
     * is 1 and every other layer is 2 or above, so it is the highest active
     * layer exactly when the base layer is the one you are on -- and ZMK
     * matches a combo against the highest active layer alone, not against every
     * active one. A base-layer combo that lists ALPHA1 without ALT_OS therefore
     * stops firing the moment os-detection decides this host is a Mac, and
     * keeps working everywhere else, which is a miserable thing to debug.
     * Use ALPHA1_BASE, never a bare ALPHA1.
     */
    #define ALPHA1_BASE                 ALPHA1 ALT_OS
    #define ALPHA1_LAYERS               ALPHA1_BASE CASE_A1 CPLK_A1 ALTREP2 SEN_CASE
    #define CCEDIL_LAYERS               CCEDIL CASE_CCEDIL
    #define ALPHA2_LAYERS               ALPHA2 CASE_A2 SFT_A2
    #define NUM_LAYERS                  NUM NUM_CP
    #define SYM_LAYERS                  SYM SYM_CP
    #define NAV_LAYERS                  NAV NAV_CP
    #define VIM_LAYERS_BASE             VIM_INSERT VIM_REPLACE VIM_CMDLINE
    #define VIM_LAYERS_VIM              VIM_NORMAL VIM_VISUAL VIM_CHANGE
    #define VIM_LAYERS                  VIM_LAYERS_BASE VIM_LAYERS_VIM
    #define FIXABLE_LAYERS              ALPHA1_LAYERS NUM_LAYERS MEDIA NAV_LAYERS MEHS FUN                                           VIM_LAYERS
    #define ALL_LAYERS                  ALPHA1_LAYERS ALPHA2_LAYERS CCEDIL_LAYERS NUM_LAYERS NAV_LAYERS SYM_LAYERS MEDIA TEXT SHORTS VIM_LAYERS
    #define ALL_LAYERS_WITH_ENTER       ALPHA1_LAYERS ALPHA2_LAYERS CCEDIL_LAYERS NUM_LAYERS NAV_LAYERS SYM_LAYERS MEDIA TEXT        VIM_LAYERS_BASE
    #define ALL_LAYERS_WITH_BACKSPACE   ALPHA1_LAYERS ALPHA2_LAYERS CCEDIL_LAYERS NUM_LAYERS NAV_LAYERS SYM_LAYERS                   VIM_LAYERS_BASE
    #define ALL_LAYERS_WITH_ESC         ALPHA1_LAYERS ALPHA2_LAYERS CCEDIL_LAYERS                 MEHS                               VIM_LAYERS

    combos {
        compatible = "zmk,combos";

        COMBO(cb_vim_mode,      LTR LTM LTI,     &vim_mode_on,           ALPHA1_LAYERS VIM_LAYERS)

        COMBO(cb_enter,         RHM RHR R0,      &lm_ent_vim,            ALL_LAYERS_WITH_ENTER)
        COMBO(cb_backspace,     RTM RTR,         &kp BACKSPACE,          ALL_LAYERS_WITH_BACKSPACE)
        COMBO(cb_esc,           LTR LTM,         &lm_esc_vim,            ALL_LAYERS_WITH_ESC)

        COMBO(cb_esc_save,      LTR LTM L0,      &mc_save_esc_vim,       ALL_LAYERS)

        COMBO(cb_toggles_l,     LHI LHR,         &mo TOGS,               SHORTS)
        COMBO(cb_toggles_r,     RHI RHR,         &mo TOGS,               SHORTS)

        COMBO(cb_boot_l,        LTR LBI,         &bootloader,            ALL_LAYERS)
        COMBO(cb_boot_r,        RTR RBI,         &bootloader,            ALL_LAYERS)
        COMBO(cb_cancel,        RTM RTR RTI,     &tc_cancel,             FIXABLE_LAYERS)

        COMBO(cb_save,          LHR LHM L0,      &mc_save,               ALL_LAYERS)
        COMBO(cb_fullscr,       LHM LHI L0,      &mc_fullscr,            ALL_LAYERS)
        COMBO(cb_find,          LBM LBI L0,      &mc_find,               ALL_LAYERS)
        COMBO(cb_undo,          LBR LBM L0,      &mc_undo,               ALL_LAYERS)
        COMBO(cb_tab,           RTM RTR R0,      &kp TAB,                ALL_LAYERS)
        COMBO(cb_paste,         RBI RBM R0,      &th_paste 0 0,          ALL_LAYERS)
        COMBO(cb_copy,          RHI RHM R0,      &th_copy 0 0,           ALL_LAYERS)
        COMBO(cb_selall,        RBM RBR R0,      &mc_selall,             ALL_LAYERS)
        COMBO(cb_selcopy,       RHI RHM RHR R0,  &th_selcopy 0 0,        ALL_LAYERS)
        COMBO(cb_selpaste,      RBI RBM RBR R0,  &th_selpaste 0 0,       ALL_LAYERS)

        COMBO(cb_left,          RHI R1,          &kp LEFT,               ALL_LAYERS)
        COMBO(cb_down,          RHM R1,          &kp DOWN,               ALL_LAYERS)
        COMBO(cb_up,            RHR R1,          &kp UP,                 ALL_LAYERS)
        COMBO(cb_right,         RHP R1,          &lt_right MACROS 0,     ALL_LAYERS)
        COMBO(cb_del,           RBI R1,          &kp DELETE,             ALL_LAYERS)
        COMBO(cb_home,          RBM R1,          &kp HOME,               ALL_LAYERS)
        COMBO(cb_end,           RBR R1,          &kp END,                ALL_LAYERS)

        COMBO(cb_lbrc,          LTM L0,          &th_lbrc 0 0,           ALL_LAYERS)
        COMBO(cb_rbrc,          LTI L0,          &th_rbrc 0 0,           ALL_LAYERS)
        COMBO(cb_lpar,          LHM L0,          &th_lpar 0 0,           ALL_LAYERS)
        COMBO(cb_rpar,          LHI L0,          &th_rpar 0 0,           ALL_LAYERS)
        COMBO(cb_lbkt,          LBM L0,          &th_lbkt 0 0,           ALL_LAYERS)
        COMBO(cb_rbkt,          LBI L0,          &th_rbkt 0 0,           ALL_LAYERS)

        COMBO(cb_n7,            RTI R0,          &mc_n7,                 ALL_LAYERS)
        COMBO(cb_n8,            RTM R0,          &mc_n8,                 ALL_LAYERS)
        COMBO(cb_n9,            RTR R0,          &mc_n9,                 ALL_LAYERS)
        COMBO(cb_n4,            RHI R0,          &mc_n4,                 ALL_LAYERS)
        COMBO(cb_n5,            RHM R0,          &mc_n5,                 ALL_LAYERS)
        COMBO(cb_n6,            RHR R0,          &mc_n6,                 ALL_LAYERS)
        COMBO(cb_n1,            RBI R0,          &mc_n1,                 ALL_LAYERS)
        COMBO(cb_n2,            RBM R0,          &mc_n2,                 ALL_LAYERS)
        COMBO(cb_n3,            RBR R0,          &mc_n3,                 ALL_LAYERS)
        COMBO(cb_n0,            R1 R0,           &mc_n0,                 ALL_LAYERS)

        COMBO(cb_numword,       LBR LBM,         &tc_num_word,           ALPHA1_LAYERS VIM_LAYERS_BASE)
        COMBO(cb_ca_nav,        LHR LHM L1,      &mc_ca_nav,             ALPHA1_LAYERS VIM_LAYERS)
        COMBO(cb_gcs_nav,       LBR LHM LHI L1,  &mc_gcs_nav,            ALPHA1_LAYERS VIM_LAYERS)
        COMBO(cb_cag_nav,       LHR LHM LBI L1,  &mc_cag_nav,            ALPHA1_LAYERS VIM_LAYERS)
        COMBO(cb_cas_spc,       LHR LHM LHI L0,  &mc_cas_spc,            ALPHA1_LAYERS)

        COMBO(cb_meh_spc,       LHR LHM LHI,     &ht_meh_spc 0 0,        ALPHA1_LAYERS VIM_LAYERS_BASE)
        COMBO(cb_hyp_spc,       LBR LBM LBI,     &th_hyper_space 0 0,    ALPHA1_LAYERS VIM_LAYERS_BASE)
        COMBO(cb_meh_ent,       RHI RHM RHR,     &ht_meh_ent 0 0,        ALPHA1_LAYERS VIM_LAYERS_BASE)
        COMBO(cb_hyp_ent,       RBI RBM RBR,     &th_hyper_enter 0 0,    ALPHA1_LAYERS VIM_LAYERS_BASE)

        COMBO(cb_semi,          RBM RBR,         &th_semi 0 0,           ALPHA1_LAYERS NUM_LAYERS VIM_LAYERS)

        /*
         * The letter chords come in three groups because the layers spell their
         * letters differently: the bases and ALTREP2 (armed for a second after
         * every accent, and the highest layer while it is) type plain letters,
         * sentence case types LS(), and the caps layers type RS() -- the adaptive
         * keys tell the two apart. cb_dc and cb_pc used to sit here too; they
         * shared their keys with cb_cancel and cb_meh_ent on the caps layers and
         * ZMK only ever fired the earlier combo.
         */
        COMBO(cb_k,             LTM LTI,         &kp K,                  ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)
        COMBO(cb_w,             LHM LHI,         &ht_w 0 0,              ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)
        COMBO(cb_v,             LBI LBM,         &kp V,                  ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)
        COMBO(cb_q,             LHR LHM,         &ht_q 0 0,              ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)

        COMBO(cb_ks,            LTM LTI,         &kp LS(K),              SEN_CASE)
        COMBO(cb_ws,            LHM LHI,         &kp LS(W),              SEN_CASE)
        COMBO(cb_vs,            LBI LBM,         &kp LS(V),              SEN_CASE)
        COMBO(cb_qs,            LHR LHM,         &kp LS(Q),              SEN_CASE)

        COMBO(cb_kc,            LTM LTI,         &kp RS(K),              CASE_A1 CPLK_A1)
        COMBO(cb_wc,            LHM LHI,         &kp RS(W),              CASE_A1 CPLK_A1)
        COMBO(cb_vc,            LBI LBM,         &kp RS(V),              CASE_A1 CPLK_A1)
        COMBO(cb_qc,            LHR LHM,         &kp RS(Q),              CASE_A1 CPLK_A1)

        COMBO(cb_x,             RTI RTM,         &kp X,                  ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)
        COMBO(cb_z,             RHI RHM,         &ht_z 0 0,              ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)
        COMBO(cb_j,             RBI RBM,         &kp J,                  ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)
        COMBO(cb_y,             RHM RHR,         &ht_y 0 0,              ALPHA1_BASE ALTREP2 VIM_LAYERS_BASE)

        COMBO(cb_xs,            RTI RTM,         &kp LS(X),              SEN_CASE)
        COMBO(cb_zs,            RHI RHM,         &kp LS(Z),              SEN_CASE)
        COMBO(cb_js,            RBI RBM,         &kp LS(J),              SEN_CASE)
        COMBO(cb_ys,            RHM RHR,         &kp LS(Y),              SEN_CASE)

        COMBO(cb_xc,            RTI RTM,         &kp RS(X),              CASE_A1 CPLK_A1)
        COMBO(cb_zc,            RHI RHM,         &kp RS(Z),              CASE_A1 CPLK_A1)
        COMBO(cb_jc,            RBI RBM,         &kp RS(J),              CASE_A1 CPLK_A1)
        COMBO(cb_yc,            RHM RHR,         &kp RS(Y),              CASE_A1 CPLK_A1)

        COMBO(cb_grv_vim,       LTM LTI,         &kp GRAVE,              VIM_LAYERS_VIM)
        COMBO(cb_x_vim,         RTI RTM,         &lm_x_vim,              VIM_LAYERS_VIM)
        COMBO(cb_d_vim,         RTM RTR,         &lm_d_vim,              VIM_LAYERS_VIM)
        COMBO(cb_z_vim,         LHR LHM,         &kp Z,                  VIM_LAYERS_VIM)
        COMBO(cb_m_vim,         LHM LHI,         &kp M,                  VIM_LAYERS_VIM)
        COMBO(cb_p_vim,         RHI RHM,         &lm_p_vim,              VIM_LAYERS_VIM)
        COMBO(cb_y_vim,         RHM RHR,         &lm_y_vim,              VIM_LAYERS_VIM)
        COMBO(cb_at_at_vim,     LBR LBM,         &mc_at_at,              VIM_LAYERS_VIM)
        COMBO(cb_at_vim,        LBM LBI,         &lm_at_vim,             VIM_LAYERS_VIM)
        COMBO(cb_v_vim,         RBI RBM,         &lm_v_vim,              VIM_LAYERS_VIM)

        COMBO(cb_reset_zoom,    LHR LHM,         &mc_reset_zoom,         SHORTS)

        COMBO(cb_meh_k,         LTI LTM,         &mc_meh_k,              MEHS)
        COMBO(cb_meh_w,         LHI LHM,         &mc_meh_w,              MEHS)
        COMBO(cb_meh_v,         LBI LBM,         &mc_meh_v,              MEHS)
        COMBO(cb_meh_x,         RTI RTM,         &mc_meh_x,              MEHS)
        COMBO(cb_meh_z,         RHI RHM,         &mc_meh_z,              MEHS)
        COMBO(cb_meh_j,         RBI RBM,         &mc_meh_j,              MEHS)
        COMBO(cb_meh_q,         LHR LHM,         &mc_meh_q,              MEHS)
        COMBO(cb_meh_y,         RHR RHM,         &mc_meh_y,              MEHS)
        COMBO(cb_numbers_cl,    LBM LBR,         &tc_num_word_cp,        MEHS)
        COMBO(cb_numbers_cr,    RBM RBR,         &tc_num_word_cp,        MEHS)
        COMBO(cb_meh_spc_mc,    LHR LHM LHI,     &mc_meh_space,          MEHS)
        COMBO(cb_hyp_spc_mc,    LBR LBM LBI,     &mc_hyper_space,        MEHS)
        COMBO(cb_meh_ent_mc,    RHR RHM RHI,     &mc_meh_enter,          MEHS)
        COMBO(cb_hyp_ent_mc,    RBR RBM RBI,     &mc_hyper_enter,        MEHS)

        COMBO(cb_comm,          RHP R0,          &kp COMMA,              NUM_LAYERS)
        COMBO(cb_sft_g,         RTI RTM,         &kp LS(G),              NUM_LAYERS)
        COMBO(cb_jv,            RHI RHM,         &kp J,                  NUM_LAYERS)
        COMBO(cb_kv,            RHM RHR,         &kp K,                  NUM_LAYERS)
        COMBO(cb_pipev,         RBI RBM,         &kp PIPE,               NUM_LAYERS)

        COMBO(cb_braces_new,    LTR LTM,         &mc_braces_new,         NUM_LAYERS)
        COMBO(cb_braces,        LTM LTI,         &th_braces 0 0,         NUM_LAYERS)
        COMBO(cb_pars,          LHM LHI,         &th_pars 0 0,           NUM_LAYERS)
        COMBO(cb_brackets,      LBM LBI,         &th_brackets 0 0,       NUM_LAYERS)
        COMBO(cb_and,           LHR LHM,         &th_and 0 0,            NUM_LAYERS)
        COMBO(cb_or,            LBR LBM,         &th_or 0 0,             NUM_LAYERS)

        COMBO(cb_enddoent,      LTR LTM LTI,     &mc_end_do_ent,         NUM_LAYERS)
        COMBO(cb_par_semi,      LHR LHM LHI,     &th_pars_semi 0 0,      NUM_LAYERS)
        COMBO(cb_ltgtlprp,      LBR LBM LBI,     &th_end_ltgtlprp 0 0,   NUM_LAYERS)

        COMBO(cb_ord_o,         RHR RHM RHI,     &th_ord_o_a 0 0,        NUM_LAYERS)
        COMBO(cb_deg,           RBR RBM RBI,     &mc_deg,                NUM_LAYERS)

        COMBO(cb_darrow,        LTR LTM,         &th_darrow 0 0,         SYM_LAYERS)
        COMBO(cb_sarrow,        LHR LHM,         &th_sarrow 0 0,         SYM_LAYERS)
        COMBO(cb_concat,        LBR LBM,         &th_concat 0 0,         SYM_LAYERS)
        COMBO(cb_hcurly,        LTM LTI,         &mc_hcurly,             SYM_LAYERS)
        COMBO(cb_dcurly,        LHM LHI,         &mc_dcurly,             SYM_LAYERS)
        COMBO(cb_forward,       LBM LBI,         &th_forward 0 0,        SYM_LAYERS)
        COMBO(cb_bslash_quo,    LTR LTM LTI,     &th_bslash_quo 0 0,     SYM_LAYERS)
        COMBO(cb_tdqo,          LHR LHM LHI,     &th_tdqo 0 0,           SYM_LAYERS)
        COMBO(cb_tbti,          LBR LBM LBI,     &th_tbti 0 0,           SYM_LAYERS)

        COMBO(cb_eu,            RTR RTM RTI,     &th_eur 0 0,            SYM_LAYERS)
        COMBO(cb_br,            RHR RHM RHI,     &th_br 0 0,             SYM_LAYERS)
        COMBO(cb_us,            RBR RBM RBI,     &th_us 0 0,             SYM_LAYERS)

        COMBO(cb_pcurly,        RTI RTM,         &mc_pcurly,             SYM_LAYERS)
        COMBO(cb_eqeq,          RHM RHR,         &th_eqeq 0 0,           SYM_LAYERS)
        COMBO(cb_noteq,         RBM RBR,         &th_noteq 0 0,          SYM_LAYERS)
        COMBO(cb_backword,      RHI RHM,         &th_backward 0 0,       SYM_LAYERS)
        COMBO(cb_colon_colon,   RBI RBM,         &th_dcolon 0 0,         SYM_LAYERS)

        COMBO(cb_btclr,         LTM LTR,         &bt BT_CLR,             FUN)
        COMBO(cb_f10,           RBM RBI,         &kp F10,                FUN)
        COMBO(cb_f11,           RHM RHI,         &kp F11,                FUN)
        COMBO(cb_f12,           RTM RTI,         &kp F12,                FUN)
        COMBO(cb_f13,           RBM RBR,         &kp F13,                FUN)
        COMBO(cb_f14,           RHM RHR,         &kp F14,                FUN)
        COMBO(cb_f15,           RTM RTR,         &kp F15,                FUN)

        COMBO(cb_minus,         RTI RTM,         &kp MINUS,              ALPHA2_LAYERS)
        COMBO(cb_dqo_s,         LTM LTI,         &kp DQT,                ALPHA2_LAYERS)
        COMBO(cb_sqo_s,         LHM LHI,         &kp SQT,                ALPHA2_LAYERS)
        COMBO(cb_bti_s,         LBM LBR,         &kp GRAVE,              ALPHA2_LAYERS)
        COMBO(cb_caret_s,       LHR LHM,         &kp CARET,              ALPHA2_LAYERS)
        COMBO(cb_tilde_s,       LBI LBM,         &kp TILDE,              ALPHA2_LAYERS)
        COMBO(cb_ques,          RHI RHM,         &kp QMARK,              ALPHA2_LAYERS)
        COMBO(cb_excl,          RBI RBM,         &kp EXCL,               ALPHA2_LAYERS)
        COMBO(cb_colon,         RBM RBR,         &kp COLON,              ALPHA2_LAYERS)

        COMBO(cb_grva,          RHM RHR,         &ac_agrv,               ALPHA2)
        COMBO(cb_grvas,         RHM RHR,         &ac_agrv_s,             SFT_A2)
        COMBO(cb_grvac,         RHM RHR,         &ac_agrv_c,             CASE_A2)

        COMBO(cb_bsp_word,      RTM RTR,         &mc_bsp_word,           TEXT)
        COMBO(cb_o_esc,         RHI RHM,         &mc_o_esc,              TEXT)
        COMBO(cb_sft_o_esc,     RHM RHR,         &mc_sft_o_esc,          TEXT)
        COMBO(cb_dqt0p,         RHI RHM RHR,     &mc_dqt0p,              TEXT)
        COMBO(cb_v_r,           RBI RBM RBR,     &kp V,                  TEXT)
        COMBO(cb_shiftv,        RBM RBR,         &kp LS(V),              TEXT)
        COMBO(cb_ctrlv,         RBI RBM,         &kp LC(V),              TEXT)

        COMBO(cb_enter_vim,     RTI RTM,         &vim_mode_on,           MACROS)
        COMBO(cb_leave_vim,     RTM RTR,         &vim_mode_off,          MACROS)

        COMBO(cb_ca,            LHR LHM,         &kp LC(LALT),           NAV_LAYERS)

        COMBO(cb_down_end,      RBI RBM,         &mc_down_end,           NAV_LAYERS)
        COMBO(cb_numbers,       RBM RBR,         &mo NUM_CP,             NAV_LAYERS)
        COMBO(cb_up_end_del,    RTM RTI,         &mc_up_end_del,         NAV_LAYERS)
        COMBO(cb_page_down,     RHM RHI,         &kp PAGE_DOWN,          NAV_LAYERS)
        COMBO(cb_page_up,       RHM RHR,         &kp PAGE_UP,            NAV_LAYERS)

        COMBO(cb_hand,          RTM RTI,         &mc_hand,               MEDIA)
        COMBO(cb_lclick,        RHM RHI,         &mkp LCLK,              MEDIA)
        COMBO(cb_rclick,        RHM RHR,         &mkp RCLK,              MEDIA)
    };

    combo_must_tap {
        MACRO(mc_ca_nav           , &macro_press &kp LCTL &kp LALT &mo NAV &macro_pause_for_release &macro_release &mo NAV &kp LCTL &kp LALT)
        MACRO(mc_gcs_nav          , &macro_press &kp LGUI &kp LCTL &kp LSFT &mo NAV &macro_pause_for_release &macro_release &mo NAV &kp LGUI &kp LCTL &kp LSFT)
        MACRO(mc_cag_nav          , &macro_press &kp LCTL &kp LALT &kp LGUI &mo NAV &macro_pause_for_release &macro_release &mo NAV &kp LCTL &kp LALT &kp LGUI)
        MACRO(mc_cas_spc          , &macro_press &kp LCTL &kp LALT &kp LSFT &mo NUM &macro_pause_for_release &macro_release &mo NUM &kp LCTL &kp LALT &kp LSFT)

        COMBO_MUST_TAP(ht_w       , &kp LSFT &kp LALT          , &kp W)
        COMBO_MUST_TAP(ht_q       , &kp LCTL &kp LALT          , &kp Q)
        COMBO_MUST_TAP(ht_z       , &kp LSFT &kp LALT          , &kp Z)
        COMBO_MUST_TAP(ht_y       , &kp LALT &kp LCTL          , &kp Y)
        COMBO_MUST_TAP(ht_meh_spc , &kp LCTL &kp LALT &kp LSFT , &mc_meh_space)
        COMBO_MUST_TAP(ht_meh_ent , &kp LCTL &kp LALT &kp LSFT , &mc_meh_enter)
    };
};

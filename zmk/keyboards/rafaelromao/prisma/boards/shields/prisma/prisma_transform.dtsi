 *
 * The Slim Diamond reads each key on its own pin. A half's direct kscan
 * reports key i as RC(0,i), in the PCB's key order:
 *
 *   0 pinky   1 ring top    2 ring home    3 ring bottom
 *             4 middle top  5 middle home  6 middle bottom
 *             7 index top   8 index home   9 index bottom
 *            10 thumb outer 11 thumb inner
 *
 * The right half adds 12 (col-offset). The shared keymap has 36 positions;
 * the 12 the Diamond doesn't have point at row 1, which nothing reports.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <24>;
        rows = <2>;
        map = <
        RC(1,0)  RC(0,1)  RC(0,4)  RC(0,7)  RC(1,1)    RC(1,12) RC(0,19) RC(0,16) RC(0,13) RC(1,13)
        RC(0,0)  RC(0,2)  RC(0,5)  RC(0,8)  RC(1,2)    RC(1,14) RC(0,20) RC(0,17) RC(0,14) RC(0,12)
        RC(1,3)  RC(0,3)  RC(0,6)  RC(0,9)  RC(1,4)    RC(1,15) RC(0,21) RC(0,18) RC(0,15) RC(1,16)
                          RC(1,5)  RC(0,10) RC(0,11)   RC(0,23) RC(0,22) RC(1,17)
        >;
    };
};
